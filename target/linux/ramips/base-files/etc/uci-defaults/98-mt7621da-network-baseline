#!/bin/sh
. /lib/ramips.sh
[ "$(ramips_board_name)" = "mt7621da-5port" ] || exit 0
# Applies also to keep-settings upgrades; the board DT disables PPE probing.
uci -q set mtkhnat.global.enable='0'
uci -q set mtkhnat.global.hqos='0'
uci -q commit mtkhnat
[ ! -x /etc/init.d/mtkhnat ] || /etc/init.d/mtkhnat disable
exit 0
