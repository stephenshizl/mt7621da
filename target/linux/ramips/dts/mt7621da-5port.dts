/* Reuse the vendor RFB NOR topology; only product hardware differences below. */
#include "mt7621-rfb-nor.dts"

/ {
    compatible = "mediatek,mt7621da-5port", "mediatek,mt7621-rfb-nor", "mediatek,mt7621-soc";
    model = "MT7621DA 5-Port Gigabit Switch (8 MiB)";

    chosen {
        bootargs = "console=ttyS0,57600";
    };

    gpio-leds {
        compatible = "gpio-leds";
        run {
            label = "green:run";
            gpios = <&gpio0 0 0>;
            default-state = "on";
        };
    };
};

/* Retain this product's programmed Factory offsets and upgrade ABI. */
&gmac0 {
    mtd-mac-address = <&factory 0xe000>;
};

&gmac1 {
    mtd-mac-address = <&factory 0xe006>;
};

&spi0 {
    m25p80@0 {
        partition@0 {
            label = "u-boot";
            read-only;
        };
        partition@30000 {
            label = "u-boot-env";
        };
        factory: partition@40000 {
            label = "factory";
            read-only;
        };
        partition@50000 {
            reg = <0x50000 0x7b0000>;
        };
    };
};
